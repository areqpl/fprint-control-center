[Unit]
Description=Fingerprint Control Center Service
After=graphical-session.target
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/owlyyy/fprint-control-center/src/main.py
Restart=on-failure
RestartSec=3s
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:0
Environment=QT_QPA_PLATFORM=xcb;wayland
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=default.target
