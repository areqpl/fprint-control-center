[Unit]
Description=Fingerprint Control Center Background Daemon
Documentation=https://github.com/areqpl/fprint-control-center
After=graphical-session.target fprintd.service
Wants=fprintd.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/owlyyy/fprint-control-center/src/main.py --background
Restart=on-failure
RestartSec=5s
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:0
Environment=QT_QPA_PLATFORM=xcb;wayland

[Install]
WantedBy=default.target
