pkgname=fprint-control-center
pkgver=1.2.0
pkgrel=1
pkgdesc='Robust PyQt6 control center daemon for fingerprint devices'
arch=('any')
url='https://github.com/areqpl/fprint-control-center'
license=('MIT')
depends=('python' 'python-pyqt6')
optdepends=('fprintd: Fingerprint management daemon D-Bus service')
source=()
sha256sums=()

package() {
    install -d "$pkgdir/usr/lib/fprint-control-center"
    install -Dm644 "$startdir/../src/__init__.py" "$pkgdir/usr/lib/fprint-control-center/__init__.py"
    install -Dm644 "$startdir/../src/exceptions.py" "$pkgdir/usr/lib/fprint-control-center/exceptions.py"
    install -Dm644 "$startdir/../src/fprint_manager.py" "$pkgdir/usr/lib/fprint-control-center/fprint_manager.py"
    install -Dm755 "$startdir/../src/main.py" "$pkgdir/usr/lib/fprint-control-center/main.py"

    install -d "$pkgdir/usr/bin"
    cat << 'EOF' > "$pkgdir/usr/bin/fprint-control-center"
#!/bin/sh
exec python3 /usr/lib/fprint-control-center/main.py "$@"
EOF
    chmod 755 "$pkgdir/usr/bin/fprint-control-center"

    install -Dm644 "$startdir/../resources/icon.png" "$pkgdir/usr/share/pixmaps/fprint-control-center.png"
    install -Dm644 "$startdir/../README.md" "$pkgdir/usr/share/doc/fprint-control-center/README.md"
    install -Dm644 "$startdir/../systemd/fprint-control-center.service" "$pkgdir/usr/lib/systemd/user/fprint-control-center.service"
}
